nextflow_pipeline {
    name "NanoVI pipeline integration tests"
    script "main.nf"
    tag "pipeline"

    // Smoke test: validates that the pipeline launches and all channels connect
    // correctly using stub execution (no real binaries or database required).
    test("Pipeline completes successfully in stub mode with test profile") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd          = "abundance"
                input        = "${projectDir}/tests/test_data/stub_reads"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                min_length   = 500
                max_length   = 2000
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // Every step's versions.yml is collected once (F33), not published with the results
            def versions = new org.yaml.snakeyaml.Yaml().load(file("${outputDir}/pipeline_info/software_versions.yml").text)
            assert versions.keySet() == ['FILTER_READS', 'INDEX_DB', 'ALIGN_READS', 'LIKELIHOOD', 'RUN_VI',
                                         'WRITE_OUTPUT', 'GENERATE_PHYLOSEQ_TABLES', 'Workflow'] as Set
            assert versions.Workflow['microbialds/NanoVI'] ==~ /\d+\.\d+\.\d+/
            assert !file("${outputDir}/sample_outputs/versions.yml").exists()
            assert !file("${outputDir}/consolidated_output/versions.yml").exists()
        }
    }

    // Parameter checks (F13, F14): each error is raised before any process runs

    test("build-database fails without --sequences") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "build-database"
                output_dir    = "${outputDir}"
                seq2tax       = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                taxonomy_list = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("For build-database you must provide --sequences and --seq2tax") }
        }
    }

    test("build-database fails without a taxonomy source") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "build-database"
                output_dir    = "${outputDir}"
                sequences     = "${projectDir}/tests/test_data/mock_db/species_taxid.fasta"
                seq2tax       = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("For build-database provide exactly one of --taxonomy_list or --ncbi_taxonomy") }
        }
    }

    test("build-database fails with both taxonomy sources") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "build-database"
                output_dir    = "${outputDir}"
                sequences     = "${projectDir}/tests/test_data/mock_db/species_taxid.fasta"
                seq2tax       = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                taxonomy_list = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                ncbi_taxonomy = "${projectDir}/tests/test_data/mock_db"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("For build-database provide exactly one of --taxonomy_list or --ncbi_taxonomy") }
        }
    }

    test("build-database runs with --ncbi_taxonomy") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "build-database"
                output_dir    = "${outputDir}"
                sequences     = "${projectDir}/tests/test_data/mock_db/species_taxid.fasta"
                seq2tax       = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                ncbi_taxonomy = "${projectDir}/tests/test_data/mock_db"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.succeeded().size() == 1
            // Published into <output_dir>/<db_name>/, not <db_name>/<db_name>/ (F41)
            assert file("${outputDir}/db_custom/species_taxid.fasta").exists()
            assert file("${outputDir}/db_custom/taxonomy.tsv").exists()
            assert !file("${outputDir}/db_custom/db_custom").exists()
        }
    }

    test("collapse-taxonomy fails without --rank") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "collapse-taxonomy"
                output_dir    = "${outputDir}"
                input_tsv     = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("For collapse-taxonomy you must provide --rank (one of: species, genus, family, order, class, phylum, superkingdom)") }
        }
    }

    test("collapse-taxonomy fails with an invalid --rank") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "collapse-taxonomy"
                output_dir    = "${outputDir}"
                input_tsv     = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                rank          = "strain"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("* --rank (strain): Expected any of [species, genus, family, order, class, phylum, superkingdom]") }
        }
    }

    test("combine-outputs fails with an invalid --rank") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                cmd           = "combine-outputs"
                output_dir    = "${outputDir}"
                input_dir     = "${projectDir}/tests/test_data/mock_db"
                rank          = "Genus"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("* --rank (Genus): Expected any of [species, genus, family, order, class, phylum, superkingdom]") }
        }
    }

    test("Directory mode keeps dots in sample IDs") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                input        = "${projectDir}/tests/test_data/multi_dot_reads"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.success
            assert file("${outputDir}/sample_outputs/S1.run1_rel-abundance.tsv").exists()
            assert file("${outputDir}/sample_outputs/S1.run2_rel-abundance.tsv").exists()
        }
    }

    test("Directory mode fails when two FASTQ files give the same sample ID") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                input        = "${projectDir}/tests/test_data/clash_reads"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            def reads = "${projectDir}/tests/test_data/clash_reads"
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Several FASTQ files in ${reads} give the same sample ID; rename them or use a samplesheet:") }
            assert (workflow.stdout + workflow.stderr).any { it.contains("S1: ${reads}/S1.fastq, ${reads}/S1.fq") }
            assert (workflow.stdout + workflow.stderr).any { it.contains("S2: ${reads}/S2.fastq, ${reads}/run2/S2.fastq") }
        }
    }

    test("Directory mode fails on sample IDs with unsafe characters") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                input        = "${projectDir}/tests/test_data/bad_id_reads"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Sample IDs from FASTQ file names may only use letters, digits, '.', '_' and '-'; rename these files or use a samplesheet:") }
            assert (workflow.stdout + workflow.stderr).any { it.contains("${projectDir}/tests/test_data/bad_id_reads/S1+run.fastq") }
        }
    }

    test("Credible intervals need the VB estimator") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                input              = "${projectDir}/tests/test_data/stub_reads"
                output_dir         = "${outputDir}"
                db                 = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv       = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                estimator          = "em"
                credible_intervals = true
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("--credible_intervals needs --estimator vb") }
        }
    }

    // Parameter and samplesheet validation (F40, F15)

    test("A value of the wrong type on the command line is rejected") {
        tag "stub"
        options "-profile test -stub-run --N abc"

        when {
            params {
                input        = "${projectDir}/tests/test_data/stub_reads"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Parameter `N` with type Integer cannot be assigned to abc") }
        }
    }

    test("A parameter outside its schema range is rejected") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            params {
                input         = "${projectDir}/tests/test_data/stub_reads"
                output_dir    = "${outputDir}"
                db            = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv  = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
                min_abundance = 1.5
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of pipeline parameters failed!") }
            assert (workflow.stdout + workflow.stderr).any { it.contains("* --min_abundance (1.5)") }
        }
    }

    test("Samplesheet input runs") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            def sheet = new File("${outputDir}/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq\nmock_A,${projectDir}/tests/test_data/stub_reads/mock_run.fastq\n"
            params {
                input        = "${outputDir}/samplesheet.csv"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.success
            assert file("${outputDir}/sample_outputs/mock_A_rel-abundance.tsv").exists()
        }
    }

    test("Samplesheet with a duplicate sample ID is rejected") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            def fq = "${projectDir}/tests/test_data/stub_reads/mock_run.fastq"
            def sheet = new File("${outputDir}/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq\nS1,${fq}\nS1,${fq}\n"
            params {
                input        = "${outputDir}/samplesheet.csv"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed!") }
            assert (workflow.stdout + workflow.stderr).any { it.contains("-> Entry 2: Detected duplicate entries: [sample:S1]") }
        }
    }

    test("Samplesheet with a bad sample name or a missing FASTQ is rejected") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            def sheet = new File("${outputDir}/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq\nS1.run1,${projectDir}/tests/test_data/stub_reads/mock_run.fastq\nS2,${projectDir}/tests/test_data/stub_reads/missing.fastq\n"
            params {
                input        = "${outputDir}/samplesheet.csv"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("-> Entry 1: Error for field 'sample' (S1.run1)") }
            assert (workflow.stdout + workflow.stderr).any { it.contains("-> Entry 2: Error for field 'fastq'") && it.contains("missing.fastq' does not exist") }
        }
    }

    test("Samplesheet without data rows is rejected") {
        tag "stub"
        options "-profile test -stub-run"

        when {
            def sheet = new File("${outputDir}/samplesheet.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq\n"
            params {
                input        = "${outputDir}/samplesheet.csv"
                output_dir   = "${outputDir}"
                db           = "${projectDir}/tests/test_data/mock_db"
                taxonomy_tsv = "${projectDir}/tests/test_data/mock_db/taxonomy.tsv"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("Samplesheet has no data rows:") }
        }
    }

    // End-to-end test: runs fastplong, minimap2 and every Python step on the
    // e2e fixture (11 real 16S sequences, 600 simulated ONT-like reads in known
    // proportions plus 30 non-16S reads). See tests/test_data/e2e/README.md.
    // NANOVI_E2E_PROFILE picks the software profile (default docker; CI also runs conda)
    test("Pipeline recovers known proportions on the e2e fixture") {
        tag "e2e"
        options "-profile test,${System.getenv('NANOVI_E2E_PROFILE') ?: 'docker'}"

        when {
            params {
                output_dir = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def readTsv = { f ->
                def lines = file(f).readLines().findAll { it }
                def header = lines[0].split('\t', -1) as List
                lines.drop(1).collect { line ->
                    def cols = line.split('\t', -1) as List
                    assert cols.size() == header.size()
                    [header, cols].transpose().collectEntries { it }
                }
            }

            def result = "${outputDir}/sample_outputs/e2e_mock_rel-abundance.tsv"
            assert file(result).exists()
            def rows = readTsv(result)
            def expected = readTsv("${projectDir}/tests/test_data/e2e/expected.tsv")

            // Assigned abundances sum to 1
            def assigned = rows.findAll { it.species && it.species.toLowerCase() != 'unassigned' }
            assert Math.abs(assigned.sum { it.abundance as double } - 1.0) < 1e-6

            // Species at 10 % or more are present and within 5 percentage points
            def observed = assigned.collectEntries { [(it.species): it.abundance as double] }
            def inDb = expected.findAll { it.tax_id != 'NA' }
            inDb.findAll { (it.expected_abundance as double) >= 0.10 }.each { exp ->
                assert observed.containsKey(exp.species)
                assert Math.abs(observed[exp.species] - (exp.expected_abundance as double)) <= 0.05
            }

            // Both members of each near-neighbour pair are reported (S. flexneri and
            // S. mitis are 5 %), and no absent species reaches 1 %
            inDb.findAll { (it.expected_abundance as double) > 0 }.each { exp ->
                assert observed.containsKey(exp.species)
            }
            inDb.findAll { (it.expected_abundance as double) == 0 }.each { exp ->
                assert (observed[exp.species] ?: 0.0) < 0.01
            }

            // The Unassigned row holds at least the non-16S reads
            def nonRrna = expected.find { it.species == 'non-16S' }.simulated_reads as int
            def unassignedRow = rows.find { it.species == 'Unassigned' }
            assert unassignedRow != null
            assert (unassignedRow.abundance as double) == 0.0
            assert (unassignedRow.estimated_counts as int) >= nonRrna

            // The Below detection row comes just before Unassigned (F06), and the
            // counts of all rows add up to the reads that passed fastplong
            assert rows[-2].species == 'Below detection'
            assert (rows[-2].abundance as double) == 0.0
            def report = "${outputDir}/qc/fastplong/e2e_mock_report.json.gz"
            def qc = new groovy.json.JsonSlurper().parse(new java.util.zip.GZIPInputStream(new FileInputStream(report)))
            assert rows.sum { it.estimated_counts as int } == qc.summary.after_filtering.total_reads

            // Consolidated phyloseq tables
            ['otu_table_abundance.tsv', 'otu_table_counts.tsv', 'tax_table.tsv', 'sample_metadata.tsv'].each { t ->
                assert file("${outputDir}/consolidated_output/${t}").exists()
            }

            // Software versions (F33): the tools and the Python image report real versions
            def versions = new org.yaml.snakeyaml.Yaml().load(file("${outputDir}/pipeline_info/software_versions.yml").text)
            assert versions.FILTER_READS.fastplong ==~ /\d+\.\d+\.\d+/
            assert versions.ALIGN_READS.minimap2 ==~ /\d+\.\d+.*/
            assert versions.RUN_VI.python.toString().startsWith('3.11.')
            ['numpy', 'pandas', 'scipy', 'pysam', 'biopython'].each { pkg ->
                assert versions.RUN_VI[pkg] && versions.RUN_VI[pkg] != 'not installed'
            }
        }
    }

    // Boolean parameters given on the command line arrive as strings on Nextflow
    // 26.04+, so `--keep_counts false` used to keep the counts; the typed params
    // block in main.nf converts them (F40). This needs the real RUN_VI and
    // WRITE_OUTPUT scripts; the interval columns are experimental (F20)
    test("--keep_counts false, --keep_files true and --credible_intervals true on the command line") {
        tag "e2e"
        options "-profile test,${System.getenv('NANOVI_E2E_PROFILE') ?: 'docker'} --keep_counts false --keep_files true --credible_intervals true"

        when {
            params {
                output_dir = "${outputDir}"
            }
        }

        then {
            assert workflow.success
            def header = file("${outputDir}/sample_outputs/e2e_mock_rel-abundance.tsv").readLines()[0].split('\t') as List
            assert header == ['species', 'abundance', 'genus', 'family', 'order', 'class', 'phylum', 'superkingdom',
                              'ci_lower', 'ci_upper', 'shared_read_fraction']
            assert !file("${outputDir}/consolidated_output/otu_table_counts.tsv").exists()
            assert file("${outputDir}/sam/e2e_mock_vi_alignments.sam").exists()
            assert file("${outputDir}/filtered/e2e_mock_filtered.fastq.gz").exists()
        }
    }
}
