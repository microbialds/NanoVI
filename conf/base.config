// conf/base.config — Default resource allocations and error handling

process {

    // ─── Global defaults ────────────────────────────────────────────────────
    // pipefail: a failure anywhere in a pipe (minimap2 | samtools) fails the task
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ─── Per-process resources and containers ───────────────────────────────
    // fastplong and minimap2 come from BioContainers: Docker pulls them from quay.io and
    // Singularity downloads the matching image from depot.galaxyproject.org. The Python
    // steps use the image built from containers/Dockerfile. Every image has its own ps,
    // which Nextflow needs for task metrics. With -profile conda the same tool versions
    // come from bioconda, and the Python steps use containers/environment.yml.

    withLabel: 'filter_reads' {
        container = { workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            'https://depot.galaxyproject.org/singularity/fastplong:0.7.0--h43da1c4_0' :
            'quay.io/biocontainers/fastplong:0.7.0--h43da1c4_0' }
        conda     = 'bioconda::fastplong=0.7.0=h43da1c4_0'
        cpus      = 2
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }

    // minimap2 2.31 with samtools 1.24 (BioContainers mulled image), for minimap2 | samtools view -b (F27)
    withLabel: 'alignment' {
        container = { workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            'https://depot.galaxyproject.org/singularity/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:ad4c240457048f1d3cc0bd8c8fa39bf27d222eb7-0' :
            'quay.io/biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:ad4c240457048f1d3cc0bd8c8fa39bf27d222eb7-0' }
        conda     = 'bioconda::minimap2=2.31=h118bc1c_0 bioconda::samtools=1.24=h9dcdb79_1'
        // Goes into the name of the cached index (INDEX_DB, F26); keep it equal to the
        // minimap2 version above (.github/scripts/check_versions.sh checks it)
        ext.minimap2_version = '2.31'
        // The retried exit codes are memory and time kills: more threads would not help
        // and would raise minimap2's memory, so only memory and time grow on retry (F28)
        cpus      = 8
        memory    = { 12.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    // The Python steps run single-threaded, so they ask for one CPU (F28)
    withLabel: 'vi_stats' {
        container = 'ghcr.io/microbialds/nanovi-python:1.0.0'
        conda     = "${projectDir}/containers/environment.yml"
        cpus      = 1
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }

    withLabel: 'vi_inference' {
        container = 'ghcr.io/microbialds/nanovi-python:1.0.0'
        conda     = "${projectDir}/containers/environment.yml"
        cpus      = 1
        memory    = { 8.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withLabel: 'vi_output' {
        container = 'ghcr.io/microbialds/nanovi-python:1.0.0'
        conda     = "${projectDir}/containers/environment.yml"
        cpus      = 1
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }

    withLabel: 'vi_database' {
        container = 'ghcr.io/microbialds/nanovi-python:1.0.0'
        conda     = "${projectDir}/containers/environment.yml"
        cpus      = 1
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }

    withLabel: 'vi_collapse' {
        container = 'ghcr.io/microbialds/nanovi-python:1.0.0'
        conda     = "${projectDir}/containers/environment.yml"
        cpus      = 1
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }

    withLabel: 'vi_combine' {
        container = 'ghcr.io/microbialds/nanovi-python:1.0.0'
        conda     = "${projectDir}/containers/environment.yml"
        cpus      = 1
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }
}
