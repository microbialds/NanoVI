// conf/base.config — Default resource allocations and error handling

process {

    // ─── Global defaults ────────────────────────────────────────────────────
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ─── Per-process resources ──────────────────────────────────────────────

    withLabel: 'filter_reads' {
        container = 'ccuriqueo/fastplong:0.2.2'
        cpus      = 2
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }

    withLabel: 'alignment' {
        container = 'quay.io/biocontainers/minimap2:2.24--h7132678_1'
        cpus      = { 8 * task.attempt }
        memory    = { 12.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withLabel: 'vi_stats' {
        container = 'ccuriqueo/vi-python:3.8'
        cpus      = 4
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }

    withLabel: 'vi_inference' {
        container = 'ccuriqueo/vi-python:3.8'
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withLabel: 'vi_output' {
        container = 'ccuriqueo/vi-python:3.8'
        cpus      = 2
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }

    withLabel: 'vi_database' {
        container = 'ccuriqueo/vi-python:3.8'
        cpus      = 2
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }

    withLabel: 'vi_collapse' {
        container = 'ccuriqueo/vi-python:3.8'
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }

    withLabel: 'vi_combine' {
        container = 'ccuriqueo/vi-python:3.8'
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }
}
