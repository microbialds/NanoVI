// conf/test.config — Minimal test configuration (e2e fixture: tests/test_data/e2e)

params {
    cmd          = 'abundance'
    input        = "${projectDir}/tests/test_data/e2e/reads"
    output_dir   = "${projectDir}/test_results"
    db           = "${projectDir}/tests/test_data/e2e/db"
    taxonomy_tsv = "${projectDir}/tests/test_data/e2e/db/taxonomy.tsv"
    N            = 3
    min_length   = 500
    max_length   = 2000
}

process {
    // Reduced resources for CI/testing
    withLabel: 'alignment' {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: 'vi_stats' {
        cpus   = 2
        memory = 2.GB
    }
    withLabel: 'vi_inference' {
        cpus   = 2
        memory = 4.GB
    }
}
