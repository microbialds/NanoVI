// conf/modules.config — Module-specific output publishing
// Each process's versions.yml is collected into pipeline_info/software_versions.yml
// (main.nf), so it is not published next to the results.

process {

    withName: 'FILTER_READS' {
        publishDir = [
            [path: { "${params.output_dir}/qc" }, mode: 'copy', pattern: 'fastplong/*'],
            [path: { "${params.output_dir}/filtered" }, mode: 'copy', pattern: '*.fastq.gz', enabled: { params.keep_files }]
        ]
    }

    withName: 'ALIGN_READS' {
        publishDir = [
            [path: { "${params.output_dir}/sam" }, mode: 'copy', enabled: { params.keep_files }, saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'WRITE_OUTPUT' {
        publishDir = [
            [path: { "${params.output_dir}/sample_outputs" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'GENERATE_PHYLOSEQ_TABLES' {
        publishDir = [
            [path: { "${params.output_dir}/consolidated_output" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'BUILD_DB' {
        publishDir = [
            [path: { "${params.output_dir}/${params.db_name}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'COLLAPSE' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'COMBINE' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }
}
