// conf/modules.config — Module-specific output publishing
// Each process's versions.yml is collected into pipeline_info/software_versions.yml
// (main.nf), so it is not published next to the results.
// `enabled` takes the value itself (a closure there is never evaluated as true) and is
// read when nextflow.config includes this file, so the include comes after the params
// block: before it, an unset --keep_files counted as true (F66). A params.keep_files
// set in a -c config comes too late; give it on the command line or in a -params-file.
// (A saveAs closure would see it, but leaves empty bam/ and filtered/ folders)

process {

    withName: 'FILTER_READS' {
        publishDir = [
            [path: { "${params.output_dir}/qc" }, mode: 'copy', pattern: 'fastplong/*'],
            [path: { "${params.output_dir}/filtered" }, mode: 'copy', pattern: '*.fastq.gz', enabled: params.keep_files]
        ]
    }

    withName: 'ALIGN_READS' {
        publishDir = [
            [path: { "${params.output_dir}/bam" }, mode: 'copy', enabled: params.keep_files, saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'RUN_VI' {
        publishDir = [
            // Only with --read_assignments; the abundance JSON stays in the work directory
            [path: { "${params.output_dir}/sample_outputs" }, mode: 'copy', pattern: '*_read_assignments.tsv.gz']
        ]
    }

    withName: 'WRITE_OUTPUT' {
        publishDir = [
            [path: { "${params.output_dir}/sample_outputs" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'GENERATE_PHYLOSEQ_TABLES' {
        publishDir = [
            [path: { "${params.output_dir}/consolidated_output" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'REPORT' {
        publishDir = [
            // report/ holds the site, the PDF, the figures and the report's own versions.yml
            [path: { "${params.output_dir}" }, mode: 'copy', pattern: 'report']
        ]
    }

    withName: 'BUILD_DB|BUILD_GTDB_DB' {
        publishDir = [
            // The process output is already <db_name>/..., so publish into output_dir itself
            [path: { "${params.output_dir}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'COLLAPSE' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }

    withName: 'COMBINE' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy', saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
        ]
    }
}
