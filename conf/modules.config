// conf/modules.config — Module-specific output publishing

process {

    withName: 'FILTER_READS' {
        publishDir = [
            [path: { "${params.output_dir}/qc" }, mode: 'copy', pattern: 'fastplong/*'],
            [path: { "${params.output_dir}/filtered" }, mode: 'copy', pattern: '*.fastq.gz', enabled: { params.keep_files }]
        ]
    }

    withName: 'ALIGN_READS' {
        publishDir = [
            [path: { "${params.output_dir}/sam" }, mode: 'copy', enabled: { params.keep_files }]
        ]
    }

    withName: 'WRITE_OUTPUT' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy']
        ]
    }

    withName: 'BUILD_DB' {
        publishDir = [
            [path: { "${params.output_dir}/${params.db_name}" }, mode: 'copy']
        ]
    }

    withName: 'COLLAPSE' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy']
        ]
    }

    withName: 'COMBINE' {
        publishDir = [
            [path: { "${params.output_dir}" }, mode: 'copy']
        ]
    }
}
