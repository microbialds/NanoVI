# .gitignore — Ignorar archivos locales y generados por Nextflow

# Work folders
work/
results/
.nextflow*
.cache/
trace.txt
timeline.html
dag.png

# Local files
conf/params_private.config

# Test 
test_results/
.nf-test/

# large files
*.mmi
*.log
*.tar.gz
*.zip

# Local databases (too large for git)
db_gtdb_r226/

# Local analysis outputs and figures
figures/
# except the benchmark figures, kept with their source data (Phase 7a)
!docs/benchmarks/figures/

# temporals
*.tmp
*.bak
*.swp

# Python

__pycache__*
*.pyc

# Local development files
CLAUDE.md
CLAUDE.local.md
.claude/
internal_docs/
