Bootstrap: docker
From: python:3.11.17-slim-trixie

# Build from the containers/ directory so that %files finds requirements.txt:
#   cd containers && singularity build nanovi-python.sif Singularity.def

%labels
    Author NanoVI developers
    Description Python environment for NanoVI variational inference pipeline
    Version 1.1.0

%files
    requirements.txt /opt/requirements.txt

%post
    # procps provides the ps that Nextflow uses to collect task metrics
    apt-get update && \
        apt-get install -y --no-install-recommends procps \
        && rm -rf /var/lib/apt/lists/*

    # Same exact pins as the Docker image
    pip install --no-cache-dir -r /opt/requirements.txt && \
        rm /opt/requirements.txt

%environment
    export LC_ALL=C

%runscript
    exec python3 "$@"
