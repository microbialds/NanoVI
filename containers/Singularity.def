Bootstrap: docker
From: python:3.8-slim

%labels
    Author NanoVI developers
    Description Python environment for NanoVI variational inference pipeline
    Version 1.0.0

%post
    apt-get update && \
        apt-get install -y --no-install-recommends \
            procps \
            gcc \
            libc6-dev \
        && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir \
        'numpy>=1.21,<2.0' \
        'pandas>=1.3,<2.0' \
        'pysam>=0.19' \
        'biopython>=1.79' \
        'flatten-dict>=0.4'

%environment
    export LC_ALL=C

%runscript
    exec python3 "$@"
