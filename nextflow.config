// nextflow.config — NanoVI pipeline configuration

// ─── LOAD CONFIG FILES ──────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ─── PLUGINS ────────────────────────────────────────────────────────────────
// nf-schema checks params against nextflow_schema.json and reads the samplesheet
// against assets/schema_input.json (F40, F15)
plugins {
    id 'nf-schema@2.8.0'
}

// ─── PARAMETERS ─────────────────────────────────────────────────────────────
params {
    // Subcommand
    cmd            = 'abundance'

    // Abundance parameters
    input          = null
    output_dir     = 'results/'
    db             = null
    db_index       = null
    index_cache_dir = null
    taxonomy_tsv   = null
    kmer_size      = 21
    N              = 3
    K              = '500M'
    type           = 'map-ont'
    split_prefix   = 'temp'
    min_length     = 500
    max_length     = 2000
    min_quality    = null
    keep_counts    = true
    keep_files     = false
    binomial_names = false

    // Abundance estimation (RUN_VI)
    estimator          = 'vb'
    min_abundance      = 0.001
    vi_tolerance       = 1e-7
    vi_max_iterations  = 1000
    alpha_prior        = 1.0
    vi_elbo_threshold  = 1e-4
    credible_intervals = false

    // Build database parameters
    db_name        = 'db_custom'
    sequences      = null
    seq2tax        = null
    ncbi_taxonomy  = null
    taxonomy_list  = null

    // Post-processing parameters
    input_tsv      = null
    input_dir      = null
    rank           = null

    // Resource caps: no task asks for more, on any retry (process.resourceLimits, F28)
    max_cpus       = 16
    max_memory     = 128.GB
    max_time       = 240.h
}

// ─── RESOURCE LIMITS ────────────────────────────────────────────────────────
// No task asks for more than --max_cpus, --max_memory and --max_time, on any retry
// (F28). Set here, after the params block: conf/base.config is read before it
process.resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]

// ─── THREADS ────────────────────────────────────────────────────────────────
// NumPy's OpenBLAS starts one thread per core of the node, so a Python step that
// asks for one CPU used several (F28). minimap2 and fastplong take their threads
// from task.cpus and don't read these
env {
    OMP_NUM_THREADS      = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
}

// ─── PROFILES ───────────────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        docker.enabled         = false
        singularity.enabled    = false
    }

    // HPC executors
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    sge {
        process.executor       = 'sge'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Test profile: small dataset, minimal resources
    test {
        includeConfig 'conf/test.config'
    }

    // Standard profile: default to Docker for backward compatibility
    standard {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }
}

// ─── MANIFEST ───────────────────────────────────────────────────────────────
manifest {
    name            = 'microbialds/NanoVI'
    author          = 'Carolina Curiqueo, Francisco Fuentes-Santander, Juan A. Ugalde'
    description     = 'Taxonomic classification of full-length 16S rRNA Nanopore reads using variational inference'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '1.1.0'
    doi             = ''
    homePage        = 'https://github.com/microbialds/NanoVI'
}

// ─── TIMELINE / REPORT ──────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/trace.txt"
    // The default fields plus what each task asked for (cpus, memory, time)
    fields  = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,time'
}
