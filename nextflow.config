// nextflow.config — NanoVI pipeline configuration

// ─── LOAD CONFIG FILES ──────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ─── PARAMETERS ─────────────────────────────────────────────────────────────
params {
    // Subcommand
    cmd            = 'abundance'

    // Abundance parameters
    input          = null
    output_dir     = 'results/'
    db             = null
    taxonomy_tsv   = null
    kmer_size      = 27
    N              = 3
    K              = 4000000000
    type           = 'map-ont'
    split_prefix   = 'temp'
    min_length     = 500
    max_length     = 2000
    keep_counts    = false
    keep_files     = false

    // Build database parameters
    db_name        = 'db_custom'
    sequences      = null
    seq2tax        = null
    ncbi_taxonomy  = null
    taxonomy_list  = null

    // Post-processing parameters
    input_tsv      = null
    input_dir      = null
    rank           = null
}

// ─── PROFILES ───────────────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) -v /usr/bin/ps:/usr/bin/ps:ro'
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    // HPC executors
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    sge {
        process.executor       = 'sge'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Test profile: small dataset, minimal resources
    test {
        includeConfig 'conf/test.config'
    }

    // Standard profile: default to Docker for backward compatibility
    standard {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) -v /usr/bin/ps:/usr/bin/ps:ro'
        singularity.enabled    = false
        conda.enabled          = false
    }
}

// ─── MANIFEST ───────────────────────────────────────────────────────────────
manifest {
    name            = 'microbialds/NanoVI'
    author          = 'Carolina Curiqueo, Francisco Fuentes-Santander, Juan A. Ugalde'
    description     = 'Taxonomic classification of full-length 16S rRNA Nanopore reads using variational inference'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.0.0'
    version         = '1.0.0'
    doi             = ''
    homePage        = 'https://github.com/microbialds/NanoVI'
}

// ─── TIMELINE / REPORT ──────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/trace.txt"
}
